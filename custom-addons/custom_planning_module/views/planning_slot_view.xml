<odoo>
    <data>
        <!-- Inherit the planning.slot form to override the domain on resource_id -->
        <record id="view_planning_slot_form_inherit_custom_domain"
                model="ir.ui.view">
            <field name="name">planning.slot.form.custom.domain</field>
            <field name="model">planning.slot</field>
            <!-- parent is the original form view of planning.slot -->
            <field name="inherit_id" ref="planning.planning_view_form"/>
            <field name="arch" type="xml">
                <!-- Find the existing resource_id field and override only its domain -->
                <field name="resource_id" position="attributes">
                    <attribute name="domain">resource_ids_domain</attribute>
                </field>
            </field>
        </record>
    </data>
</odoo>