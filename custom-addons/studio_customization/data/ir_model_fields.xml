  <record id="new_text_locations_e5da54b1-db61-4d18-8a0c-3a833790572e" model="ir.model.fields" context="{'studio': True}">
    <field name="compute"><![CDATA[for record in self:
    parts = [
        record.x_studio_street or '',
        str(record.x_studio_number) or '',
        record.x_studio_postal_code or '',
        record.x_studio_city or ''
    ]
    address = ', '.join([p for p in parts if p])
    record['x_studio_show_in_maps'] = (
        "https://www.google.com/maps/search/?api=1&query=" + address
        if address else False
    )]]></field>
    <field name="ttype">char</field>
    <field name="depends">x_studio_street,x_studio_postal_code,x_studio_number,x_studio_city</field>
    <field name="field_description">Show in maps</field>
    <field name="model">x_properties</field>
    <field name="model_id" ref="properties_93cb7511-af1d-46de-a0cb-7ee6f067ebe9"/>
    <field name="name">x_studio_show_in_maps</field>
    <field name="on_delete" eval="False"/>
    <field name="readonly" eval="True"/>
  </record>
