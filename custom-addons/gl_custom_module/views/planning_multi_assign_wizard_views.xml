<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════════
             Wizard form view
        ════════════════════════════════════════════════════════════════ -->
        <record id="view_planning_multi_assign_wizard_form" model="ir.ui.view">
            <field name="name">planning.multi_assign_wizard.form</field>
            <field name="model">planning.multi_assign_wizard</field>
            <field name="arch" type="xml">
                <form string="Multi-Shift Assignment">

                    <field name="mode" invisible="1"/>
                    <field name="available_resource_ids" invisible="1"/>

                    <!-- Result summary (shown when some resources were skipped) -->
                    <div role="alert"
                         class="alert alert-warning mb-3"
                         invisible="not creation_summary">
                        <field name="creation_summary" widget="html" nolabel="1"/>
                    </div>

                    <field name="date_outside_protocol_window" invisible="1"/>

                    <!-- Protocol visit window warning (create mode) -->
                    <div role="alert"
                         class="alert alert-warning text-center py-1 mb-1"
                         invisible="not date_outside_protocol_window or mode != 'create'">
                        <p class="align-middle mb-0">
                            <span>Shift date is outside the protocol visit window for the associated task.</span>
                        </p>
                    </div>

                    <!-- ══ CREATE MODE ════════════════════════════════════ -->
                    <group invisible="mode != 'create'">
                        <group string="Shift Details">
                            <!-- Template badges (same as planning.slot form) -->
                            <field name="template_id"
                                   options="{'no_create': True, 'horizontal': true}"
                                   widget="selection_badge"
                                   colspan="2"
                                   nolabel="1"/>

                            <!-- Left sub-group: role / project / task -->
                            <group>
                                <field name="role_id" required="mode == 'create'"/>
                                <field name="project_id"/>
                                <field name="task_id"/>
                            </group>

                            <!-- Right sub-group: shift type / dates / cap -->
                            <group>
                                <field name="shift_type_id" required="mode == 'create'"/>
                                <label for="start_datetime" string="Date"/>
                                <div class="d-flex gap-1 align-items-center">
                                    <field name="start_datetime"
                                           widget="daterange"
                                           options="{'end_date_field': 'end_datetime'}"
                                           required="mode == 'create'"
                                           nolabel="1"/>
                                    <field name="end_datetime" invisible="1"
                                           required="mode == 'create'"/>
                                </div>
                                <field name="counts_for_max_shift_per_week"/>
                            </group>

                            <!-- Additional information section -->
                            <separator string="Additional Information" colspan="2"/>
                            <field name="material_type_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   colspan="2"/>
                            <field name="reminder" colspan="2"/>
                        </group>
                        <group string="Assign Resources">
                            <!-- Placeholder: shown until all three required fields are filled -->
                            <div class="text-muted fst-italic py-2"
                                 invisible="start_datetime and shift_type_id and role_id">
                                Please select Shift Type, Role and Shift Start date/time
                                to see eligible resources.
                            </div>
                            <!-- Resource selector: only shown when all three fields are set -->
                            <div invisible="not start_datetime or not shift_type_id or not role_id"
                                 colspan="2">
                                <div class="text-muted mb-2">
                                    Only resources that are eligible for this shift
                                    (availability, role, shift type, weekly cap) are shown.
                                </div>
                                <field name="selected_resource_ids"
                                       widget="many2many_checkboxes"
                                       nolabel="1"
                                       domain="[('id', 'in', available_resource_ids)]"/>
                            </div>
                        </group>
                    </group>

                    <!-- ══ EDIT MODE ═════════════════════════════════════ -->
                    <group invisible="mode != 'edit'">
                        <group string="Shifts being edited" colspan="2">
                            <field name="slot_ids"
                                   widget="many2many_tags"
                                   readonly="1"
                                   nolabel="1"
                                   colspan="2"/>
                        </group>

                        <group string="Fields to update" colspan="2">
                            <group>
                                <field name="update_start_datetime"/>
                                <field name="start_datetime"
                                       invisible="not update_start_datetime"
                                       required="update_start_datetime and mode == 'edit'"/>

                                <field name="update_end_datetime"/>
                                <field name="end_datetime"
                                       invisible="not update_end_datetime"
                                       required="update_end_datetime and mode == 'edit'"/>

                                <field name="update_project_id"/>
                                <field name="project_id"
                                       invisible="not update_project_id"/>

                                <field name="update_task_id"/>
                                <field name="task_id"
                                       invisible="not update_task_id"/>

                                <field name="update_reminder"/>
                                <field name="reminder"
                                       invisible="not update_reminder"/>
                            </group>
                            <group>
                                <field name="update_role_id"/>
                                <field name="role_id"
                                       invisible="not update_role_id"/>

                                <field name="update_shift_type_id"/>
                                <field name="shift_type_id"
                                       invisible="not update_shift_type_id"/>

                                <field name="update_counts_for_max_shift_per_week"/>
                                <field name="counts_for_max_shift_per_week"
                                       invisible="not update_counts_for_max_shift_per_week"/>

                                <field name="update_material_type_ids"/>
                                <field name="material_type_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"
                                       invisible="not update_material_type_ids"/>
                            </group>
                        </group>
                    </group>

                    <footer>
                        <button string="Create Shifts"
                                type="object"
                                name="action_confirm"
                                class="btn-primary"
                                invisible="mode != 'create'"/>
                        <button string="Apply Changes"
                                type="object"
                                name="action_confirm"
                                class="btn-primary"
                                invisible="mode != 'edit'"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
             Standalone act_window — must be declared before any
             %(action_planning_multi_assign_create_window)d references.
        ════════════════════════════════════════════════════════════════ -->
        <record id="action_planning_multi_assign_create_window" model="ir.actions.act_window">
            <field name="name">Create Multi-Resource Shifts</field>
            <field name="res_model">planning.multi_assign_wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{"default_mode": "create"}</field>
        </record>

        <!-- Menu item under Planning > Schedule (managers only) -->
        <menuitem id="menu_planning_multi_assign_create"
                  name="Create Multi-Resource Shifts"
                  parent="planning.planning_menu_schedule"
                  action="action_planning_multi_assign_create_window"
                  groups="planning.group_planning_manager"
                  sequence="150"/>

        <!-- ═══════════════════════════════════════════════════════════════
             List view: "Edit Selected Shifts" in the <header> selection bar.
             Appears only when records are selected (Odoo 17 list behaviour).
             "Create Multi-Resource Shifts" is accessible via the menu item.
        ════════════════════════════════════════════════════════════════ -->
        <record id="view_planning_slot_list_multi_assign_inherit" model="ir.ui.view">
            <field name="name">planning.slot.list.multi_assign_button</field>
            <field name="model">planning.slot</field>
            <field name="inherit_id" ref="planning.planning_view_tree"/>
            <field name="arch" type="xml">
                <header position="inside">
                    <button string="Create Multi-Resource Shifts"
                            name="action_open_multi_assign_create_wizard"
                            type="object"
                            class="btn btn-secondary"
                            groups="planning.group_planning_manager"/>
                    <button string="Edit Selected Shifts"
                            name="action_open_multi_assign_edit_wizard"
                            type="object"
                            class="btn btn-secondary"
                            groups="planning.group_planning_manager"/>
                </header>
            </field>
        </record>
    </data>
</odoo>
