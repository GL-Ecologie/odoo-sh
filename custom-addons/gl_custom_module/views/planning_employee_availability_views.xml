<odoo>
    <data>

        <record id="view_gl_custom_planning_employee_availability_tree" model="ir.ui.view">
            <field name="name">planning.employee_availability_entry_tree</field>
            <field name="model">planning.employee_availability_entry</field>
            <field name="arch" type="xml">
                <tree decoration-success="state == 'validated'"
                      decoration-warning="state == 'to_validate'"
                      decoration-muted="state == 'draft'">
                    <field name="employee_id"/>
                    <field name="date"/>
                    <field name="shift_type_id"/>
                    <field name="available"/>
                    <field name="state" readonly="1"/>
                    <field name="notes"/>
                </tree>
            </field>
        </record>
        <record id="view_gl_custom_planning_employee_availability_form" model="ir.ui.view">
            <field name="name">planning.employee_availability_entry_form</field>
            <field name="model">planning.employee_availability_entry</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_request_validation" string="Request validation" type="object" class="btn-primary" groups="base.group_user,!planning.group_planning_manager" invisible="state != 'draft'"/>
                        <button name="action_validate" string="Validate availability" type="object" class="btn-primary" groups="planning.group_planning_manager" invisible="state != 'validation_requested'"/>
                        <button name="action_reset_to_draft" string="Reste to draft" type="object" class="btn-secondary" groups="planning.group_planning_manager" invisible="state == 'draft'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,validation_requested,validated" readonly="1"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="shift_type_id"/>
                            <field name="available"/>
                            <field name="notes"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_gl_custom_planning_employee_availability_search" model="ir.ui.view">
            <field name="name">planning.employee_availability_entry_search</field>
            <field name="model">planning.employee_availability_entry</field>
            <field name="arch" type="xml">
                <search>
                    <field name="employee_id"/>
                    <field name="shift_type_id"/>
                    <field name="date"/>
                    <field name="state"/>
                    <field name="available"/>
                    <separator/>
                    <filter name="filter_my_entries" string="My Entries" domain="[('employee_id.user_id', '=', uid)]"/>
                    <separator/>
                    <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_to_validate" string="Validation requested" domain="[('state', '=', 'validation_requested')]"/>
                    <filter name="filter_validated" string="Validated" domain="[('state', '=', 'validated')]"/>
                    <separator/>
                    <filter name="filter_available" string="Available" domain="[('available', '=', True)]"/>
                    <filter name="filter_unavailable" string="Unavailable" domain="[('available', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                        <filter name="group_by_shift_type" string="Shift type" context="{'group_by': 'shift_type_id'}"/>
                        <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_gl_custom_planning_employee_availability_calendar" model="ir.ui.view">
            <field name="name">planning.employee_availability_entry_calendar</field>
            <field name="model">planning.employee_availability_entry</field>
            <field name="arch" type="xml">
                <calendar string="Employee Availability" date_start="date" color="state" mode="month" event_open_popup="true">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="shift_type_id"/>
                    <field name="available"/>
                    <field name="state"/>
                </calendar>
            </field>
        </record>

        <record id="action_planning_employee_availability" model="ir.actions.act_window">
            <field name="name">Employee Availability</field>
            <field name="res_model">planning.employee_availability_entry</field>
            <field name="view_mode">tree,calendar,form</field>
            <field name="search_view_id" ref="view_gl_custom_planning_employee_availability_search"/>
            <field name="context">{'search_default_filter_my_entries': 1}</field>
        </record>

        <record id="menu_employee_availability_root" model="ir.ui.menu">
            <field name="name">Employee Availability</field>
            <field name="parent_id" ref="planning.planning_menu_root"/>
            <field name="sequence">20</field>
            <field name="action" ref="action_planning_employee_availability"/>
        </record>
    </data>
</odoo>