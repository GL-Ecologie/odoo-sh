<odoo>
    <data>
        <record id="view_gl_custom_planning_employee_availability_list" model="ir.ui.view">
            <field name="name">planning.employee_availability_entry_list</field>
            <field name="model">planning.employee_availability_entry</field>
            <field name="arch" type="xml">
                <list decoration-success="state == 'validated'"
                      decoration-warning="state == 'validation_requested'"
                      decoration-muted="state == 'draft'">
                    <header>
                        <button name="action_validate" string="Validate availability" type="object" class="btn-primary" groups="planning.group_planning_manager"/>
                        <button name="action_reset_to_draft" string="Reset to draft" type="object" class="btn-secondary" groups="planning.group_planning_manager"/>
                    </header>
                    <field name="resource_id" groups="planning.group_planning_manager"/>
                    <field name="date"/>
                    <field name="shift_type_id"/>
                    <field name="available"/>
                    <field name="state" readonly="1"/>
                    <field name="notes"/>
                </list>
            </field>
        </record>
        <record id="view_gl_custom_planning_employee_availability_form" model="ir.ui.view">
            <field name="name">planning.employee_availability_entry_form</field>
            <field name="model">planning.employee_availability_entry</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_request_validation" string="Request validation" type="object" class="btn-primary" groups="base.group_user,!planning.group_planning_manager" invisible="state != 'draft'"/>
                        <button name="action_validate" string="Validate availability" type="object" class="btn-primary" groups="planning.group_planning_manager" invisible="state != 'validation_requested'"/>
                        <button name="action_reset_to_draft" string="Reste to draft" type="object" class="btn-secondary" groups="planning.group_planning_manager" invisible="state == 'draft'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,validation_requested,validated" readonly="1"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="resource_id" groups="planning.group_planning_manager"/>
                            <field name="date"/>
                            <field name="shift_type_id"/>
                            <field name="available"/>
                            <field name="notes"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="view_gl_custom_planning_employee_availability_multi_create_form" model="ir.ui.view">
            <field name="name">planning.employee_availability_entry_multi_create_form</field>
            <field name="model">planning.employee_availability_entry</field>
            <field name="arch" type="xml">
                <form string="Batch creation">
                    <group>
                     <field name="shift_type_id" options="{'no_quick_create': True}" required="1"/>
                     <field name="available" options="{'no_quick_create': True}" required="1"/>
                 </group>
                </form>
            </field>
        </record>

        <record id="view_gl_custom_planning_employee_availability_search" model="ir.ui.view">
            <field name="name">planning.employee_availability_entry_search</field>
            <field name="model">planning.employee_availability_entry</field>
            <field name="arch" type="xml">
                <search string="Entries">
                    <field name="resource_id"/>
                    <field name="shift_type_id"/>
                    <field name="date"/>
                    <field name="state"/>
                    <field name="available"/>
                    <separator/>
                    <filter name="filter_my_entries" string="My Entries" domain="[('resource_id.user_id', '=', uid)]"/>
                    <separator/>
                    <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_validation_requested" string="Validation requested" domain="[('state', '=', 'validation_requested')]"/>
                    <filter name="filter_validated" string="Validated" domain="[('state', '=', 'validated')]"/>
                    <separator/>
                    <filter name="filter_available" string="Available" domain="[('available', '=', True)]"/>
                    <filter name="filter_unavailable" string="Unavailable" domain="[('available', '=', False)]"/>
                    <group>
                        <filter name="group_by_employee" string="Employee" context="{'group_by': 'resource_id'}"/>
                        <filter name="group_by_shift_type" string="Shift type" context="{'group_by': 'shift_type_id'}"/>
                        <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_gl_custom_planning_employee_availability_calendar" model="ir.ui.view">
            <field name="name">planning.employee_availability_entry_calendar</field>
            <field name="model">planning.employee_availability_entry</field>
            <field name="arch" type="xml">
                <calendar string="Availability"
                    js_class="employee_availability_calendar"
                    date_start="date"
                    multi_create_view="gl_custom_module.view_gl_custom_planning_employee_availability_multi_create_form"
                    form_view_id="%(view_gl_custom_planning_employee_availability_form)d"
                    event_open_popup="true"
                    quick_create="0"
                    mode="month">
                    <field name="resource_id"
                        filters="1"
                        write_model="planning.employee_availability_calendar_resource"
                        write_field="resource_id"
                        filter_field="checked"
                        groups="planning.group_planning_user"/>
                    <field name="state"/>
                    <field name="available"/>
                    <field name="style_key"/>
                    <field name="name"/>
                </calendar>
            </field>
        </record>

        <record id="view_gl_custom_planning_employee_availability_my_calendar" model="ir.ui.view">
            <field name="name">planning.employee_availability_my_calendar</field>
            <field name="model">planning.employee_availability_entry</field>
            <field name="arch" type="xml">
                <calendar string="Availability"
                    js_class="employee_availability_calendar"
                    date_start="date"
                    multi_create_view="gl_custom_module.view_gl_custom_planning_employee_availability_multi_create_form"
                    form_view_id="%(view_gl_custom_planning_employee_availability_form)d"
                    event_open_popup="true"
                    quick_create="0"
                    mode="month"
                    >
                    <field name="resource_id"
                        filters="1"
                        write_model="planning.employee_availability_calendar_resource"
                        write_field="resource_id"
                        filter_field="checked"
                        groups="planning.group_planning_user"/>
                    <field name="state"/>
                    <field name="available"/>
                    <field name="style_key"/>
                    <field name="name"/>
                </calendar>
            </field>
        </record>

        <record id="action_planning_employee_availability" model="ir.actions.act_window">
            <field name="name">Employee Availability</field>
            <field name="res_model">planning.employee_availability_entry</field>
            <field name="view_mode">list,calendar,form</field>
            <field name="search_view_id" ref="view_gl_custom_planning_employee_availability_search"/>
            <field name="context">{'search_default_filter_my_entries': 0}</field>
        </record>

        <record id="action_planning_employee_availability_my_calendar" model="ir.actions.act_window">
            <field name="name">My availability</field>
            <field name="res_model">planning.employee_availability_entry</field>
            <field name="path">my-availability</field>
            <field name="view_mode">calendar,list,form</field>
            <field name="mobile_view_mode">calendar</field>
            <field name="context">{'search_default_filter_my_entries': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No availability entries found. Let's create one!
                </p><p>
                    Find here your planning availability entries. Indicate your availability and request/aprove it.
                </p>
            </field>
        </record>

        <record id="planning_action_calendar_view_calendar" model="ir.actions.act_window.view">
            <field name="sequence" eval="10"/>
            <field name="view_mode">calendar</field>
            <field name="view_id" ref="view_gl_custom_planning_employee_availability_calendar"/>
            <field name="act_window_id" ref="action_planning_employee_availability"/>
        </record>
        
        <record id="planning_action_my_calendar_view_calendar" model="ir.actions.act_window.view">
            <field name="sequence" eval="10"/>
            <field name="view_mode">calendar</field>
            <field name="view_id" ref="view_gl_custom_planning_employee_availability_my_calendar"/>
            <field name="act_window_id" ref="action_planning_employee_availability_my_calendar"/>
        </record>

        <record id="action_planning_employee_availability_batch_validate" model="ir.actions.server">
            <field name="name">Validate availability</field>
            <field name="model_id" ref="gl_custom_module.model_planning_employee_availability_entry"/>
            <field name="binding_model_id" ref="gl_custom_module.model_planning_employee_availability_entry"/>
            <field name="binding_view_types">list,calendar</field>
            <field name="state">code</field>
            <field name="code">records.action_validate()</field>
        </record>

        <record id="action_planning_employee_availability_batch_reset_to_draft" model="ir.actions.server">
            <field name="name">Reset to draft</field>
            <field name="model_id" ref="gl_custom_module.model_planning_employee_availability_entry"/>
            <field name="binding_model_id" ref="gl_custom_module.model_planning_employee_availability_entry"/>
            <field name="binding_view_types">list,calendar</field>
            <field name="state">code</field>
            <field name="code">records.action_reset_to_draft()</field>
        </record>

        <record id="menu_employee_availability_root" model="ir.ui.menu">
            <field name="name">Employee Availability</field>
            <field name="parent_id" ref="planning.planning_menu_root"/>
            <field name="sequence">20</field>
        </record>

            <menuitem
                id="planning_menu_availability"
                name="Availability by resource"
                sequence="20"
                parent="menu_employee_availability_root"
                action="action_planning_employee_availability"
                groups="planning.group_planning_manager"/>
            <menuitem
                id="planning_menu_my_availability"
                name="My availability"
                sequence="30"
                parent="menu_employee_availability_root"
                action="action_planning_employee_availability_my_calendar"/>
    </data>
</odoo>