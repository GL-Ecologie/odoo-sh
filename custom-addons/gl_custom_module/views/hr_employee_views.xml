<odoo>
    <data>
        <record id="view_hr_employee_form_custom_planning" model="ir.ui.view">
            <field name="name">hr.employee.form.custom.planning</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='work_information']" position="inside">
                    <group name="planning" string="Planning">
                        <field name="max_shifts_per_week"/>
                        <field name="allowed_shift_type_ids" widget="many2many_tags"/>
                        <field name="available_to_work_weekends"/>
                        <field name="combine_evening_morning_shift"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>