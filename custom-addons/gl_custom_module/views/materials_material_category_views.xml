<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <!-- List view -->
    <record model="ir.ui.view" id="view_gl_custom_materials_material_category_list">
      <field name="name">gl_custom_module_materials_material_category list</field>
      <field name="model">materials.material_category</field>
      <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="material_type_ids"/>
        </list>
      </field>
    </record>

    <!-- Form view -->
    <record id="view_gl_custom_materials_material_category_form" model="ir.ui.view">
        <field name="name">materials.material_category_form</field>
        <field name="model">materials.material_category</field>
        <field name="arch" type="xml">
            <form string="Material category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="material_type_ids"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to open Material categories -->
    <record id="action_materials_material_category" model="ir.actions.act_window">
        <field name="name">Material categories</field>
        <field name="res_model">materials.material_category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and manage your material categories here.
            </p>
        </field>
    </record>
      
    <!-- Menu item under Planning configuration -->
    <menuitem id="menu_materials_material_category"
              name="Material categories"
              parent="menu_materials_root"
              action="action_materials_material_category"
              sequence="20"
              groups="planning.group_planning_manager"/>
  </data>
</odoo>