<odoo>
    <data>
        <!-- Hide the native Planning > Configuration > Materials menu (replaced by our custom materials system) -->
        <record id="planning.planning_menu_settings_resource" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>

        <record id="view_planning_slot_form_inherit_custom_domain" model="ir.ui.view">
            <field name="name">planning.slot.form.custom.domain</field>
            <field name="model">planning.slot</field>
            <field name="inherit_id" ref="planning.planning_view_form"/>
            <field name="arch" type="xml">
                <field name="resource_id" position="attributes">
                    <attribute name="domain">resource_ids_domain</attribute>
                </field>
                <xpath expr="//header" position="inside">
                    <button string="Register Hours"
                            name="action_register_timesheet"
                            type="object"
                            class="btn btn-primary"
                            invisible="not resource_id or not start_datetime or state != 'published' or not can_register_hours"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="before">
                    <div role="alert"
                         class="alert alert-warning text-center py-1 mb-1"
                         invisible="not date_outside_protocol_window">
                        <p class="align-middle mb-0">
                            <span>Shift date is outside the protocol visit window for the associated task.</span>
                        </p>
                    </div>
                </xpath>
                <xpath expr="//group[@name='slot_info_right']" position="inside">
                    <field name="resource_ids_domain" invisible="1"/>
                    <field name="can_register_hours" invisible="1"/>
                    <field name="counts_for_max_shift_per_week"/>
                    <field name="date_outside_protocol_window" invisible="1"/>
                </xpath>
                <xpath expr="//group[@name='slot_info_right']" position="after">
                    <group name="materials_needed_group" string="Materials needed" colspan="1">
                        <field name="material_type_ids" widget="many2many_tags"/>
                    </group>
                </xpath>
            </field>
        </record>
        <record id="view_planning_slot_form_gantt_gl_custom" model="ir.ui.view">
            <field name="name">planning.slot.form.gantt.gl_custom</field>
            <field name="model">planning.slot</field>
            <field name="inherit_id" ref="planning.planning_view_form_in_gantt"/>
            <field name="arch" type="xml">
                <xpath expr="//footer/button[@name='action_self_assign']" position="replace">
                    <button string="Request shift" type="action" groups="base.group_user,!planning.group_planning_manager" class="btn btn-primary" name="studio_customization.request_assignment_7a79e11f-811d-41cc-b72b-7346e4636a2f" invisible="not is_users_role or is_past or not start_datetime or not end_datetime or resource_id and not request_to_switch"/>
                </xpath>
                <xpath expr="//footer" position="inside">
                    <field name="can_register_hours" invisible="1"/>
                    <button string="Register Hours"
                            name="action_register_timesheet"
                            type="object"
                            class="btn btn-primary"
                            invisible="not resource_id or not start_datetime or state != 'published' or not can_register_hours"/>
                </xpath>
            </field>
        </record>
        <!-- Change "Schedule by Project" gantt default grouping from
             project only → project + task. -->
        <record id="view_planning_gantt_group_by_project_task_default" model="ir.ui.view">
            <field name="name">planning.slot.gantt.group.by.project.task.default</field>
            <field name="model">planning.slot</field>
            <field name="inherit_id" ref="project_forecast.planning_view_gantt_group_by_project"/>
            <field name="arch" type="xml">
                <xpath expr="/gantt" position="attributes">
                    <attribute name="default_group_by">project_id,task_id</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>