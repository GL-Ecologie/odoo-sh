<odoo>
    <data>
        <record id="view_planning_employee_availability_batch_edit_wizard_form" model="ir.ui.view">
            <field name="name">planning.employee_availability_batch_edit_wizard_form</field>
            <field name="model">planning.employee_availability_batch_edit_wizard</field>
            <field name="arch" type="xml">
                <form string="Batch Edit Availability Entries">
                    <sheet>
                        <group>
                            <field name="set_shift_type"/>
                            <field name="shift_type_id" invisible="not set_shift_type"/>

                            <field name="set_available"/>
                            <field name="available" invisible="not set_available"/>
                        </group>

                        <field name="entry_ids" invisible="1"/>
                    </sheet>
                    <footer>
                        <button name="action_apply"
                                string="Apply"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancel"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_planning_employee_availability_batch_edit_wizard" model="ir.actions.server">
            <field name="name">Batch Edit Availability</field>
            <field name="model_id" ref="model_planning_employee_availability_entry"/>
            <field name="binding_model_id" ref="model_planning_employee_availability_entry"/>
            <field name="binding_view_types">list,calendar</field>
            <field name="state">code</field>
            <field name="code">
        action = env["planning.employee_availability_batch_edit_wizard"].with_context(
            active_ids=records.ids
        ).action_open_wizard()
            </field>
        </record>
    </data>
</odoo>