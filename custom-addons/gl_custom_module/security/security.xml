<odoo>
    <data>
        <record id="planning_employee_availability_entry_rule_user_own" model="ir.rule">
            <field name="name">Employee availability: users see own entries</field>
            <field name="model_id" ref="model_planning_employee_availability_entry"/>
            <field name="domain_force">[('resource_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="planning_employee_availability_entry_rule_manager_all" model="ir.rule">
            <field name="name">Employee availability: managers see all entries</field>
            <field name="model_id" ref="model_planning_employee_availability_entry"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('planning.group_planning_manager'))]"/>
        </record>
    </data>
</odoo>