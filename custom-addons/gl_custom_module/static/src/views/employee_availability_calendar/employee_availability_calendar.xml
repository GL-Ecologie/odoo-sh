<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="gl_custom_module.EmployeeAvailabilityCalendarController"
       t-inherit="web.CalendarController"
       t-inherit-mode="extension">
        <xpath expr="//*[hasclass('o_calendar_sidebar')]" position="inside">
            <AvailabilityLegend/>
        </xpath>
    </t>

    <t t-name="gl_custom_module.AvailabilityCalendarLegend">
        <div class="o_employee_availability_legend">
            <div class="o_employee_availability_legend_title">Legend</div>
            <div class="o_employee_availability_legend_item">
                <span class="o_employee_availability_marker o_availability_draft"></span>
                <span>Draft</span>
            </div>
            <div class="o_employee_availability_legend_item">
                <span class="o_employee_availability_marker o_availability_validation_requested_yes"></span>
                <span>Validation requested | Available</span>
            </div>
            <div class="o_employee_availability_legend_item">
                <span class="o_employee_availability_marker o_availability_validation_requested_no"></span>
                <span>Validation requested | Not available</span>
            </div>
            <div class="o_employee_availability_legend_item">
                <span class="o_employee_availability_marker o_availability_validated_yes"></span>
                <span>Validated | Available</span>
            </div>
            <div class="o_employee_availability_legend_item">
                <span class="o_employee_availability_marker o_availability_validated_no"></span>
                <span>Validated | Not available</span>
            </div>
        </div>
    </t>

</templates>